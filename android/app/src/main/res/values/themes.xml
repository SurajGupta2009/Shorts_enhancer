<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Platform theme on purpose: no AppCompat, no Material dependency, smaller APK,
         faster cold start, and one less thing to break in CI. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Look only. android:layout_* inside a style is silently ignored by the inflater, so
         sizes and margins stay in the layout files where they actually take effect. -->
    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
        <item name="android:elevation">1dp</item>
    </style>

    <!-- the dark banner at the top of the settings screen -->
    <style name="Header">
        <item name="android:background">@drawable/bg_header</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <style name="HeaderTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="HeaderSub">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">#FFAEBBD4</item>
    </style>

    <style name="StatusPill">
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent_deep</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="Body">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Muted">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Action">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- the full-screen block screen -->
    <style name="BlockScreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
